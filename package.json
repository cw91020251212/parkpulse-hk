{
  "name": "parkspot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node scripts/build-pages-data.mjs && tsc --noEmit && vite build --mode pages",
    "check": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types scripts/check-vacancy.mjs",
    "test:charging": "node --experimental-strip-types scripts/check-ev-charging.mjs",
    "test:photos": "node scripts/check-photo-proxy.mjs",
    "test:startup": "node scripts/check-fast-start.mjs",
    "test:startup-location": "node scripts/check-startup-location.mjs",
    "test:map-markers": "node scripts/check-map-facility-markers.mjs",
    "test:map-zoom-style": "node scripts/check-map-zoom-style.mjs",
    "test:vehicle-selection": "node scripts/check-vehicle-selection.mjs",
    "test:washroom-icons": "node scripts/check-washroom-icons.mjs",
    "test:total-spaces": "node scripts/check-total-spaces.mjs",
    "test:official-static-carparks": "node scripts/check-official-static-carparks.mjs",
    "test:official-pricing": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/check-official-pricing.mjs",
    "test:operator-rates": "node scripts/check-operator-rates.mjs",
    "refresh:brand-icons": "node scripts/refresh-brand-icons.mjs",
    "test:brand-icons": "node scripts/check-brand-icons.mjs",
    "test:accessible-parking": "node --experimental-strip-types scripts/check-accessible-parking.mjs",
    "test:toilets": "node scripts/check-public-toilets.mjs",
    "test:toilet-photos": "node scripts/check-toilet-photos.mjs",
    "test:place-details": "node --experimental-strip-types scripts/check-place-details.mjs",
    "test:verified-place-links": "node scripts/check-verified-place-links.mjs",
    "test:lcsd-venues": "node scripts/check-lcsd-venues.mjs",
    "test:lcsd-park-washrooms": "node scripts/check-lcsd-park-washrooms.mjs",
    "audit:lcsd-named-toilets": "python3 scripts/audit-lcsd-named-toilets.py",
    "test:toilet-dedupe": "node --experimental-strip-types scripts/check-toilet-dedupe.mjs",
    "test:afcd-country-park-toilets": "node scripts/check-afcd-country-park-toilets.mjs",
    "test:had-community-toilets": "node scripts/check-had-community-toilets.mjs",
    "test:afcd-nature-centre-toilets": "node scripts/check-afcd-nature-centre-toilets.mjs",
    "test:afcd-long-valley-temporary-toilets": "node scripts/check-afcd-long-valley-temporary-toilets.mjs",
    "test:nearby-facilities": "node scripts/check-nearby-facilities.mjs",
    "test:atm-crosscheck": "node scripts/check-atm-crosscheck.mjs",
    "test:on-street": "node scripts/check-on-street-parking.mjs",
    "test:on-street-limit": "node --experimental-strip-types scripts/check-on-street-render-limit.mjs",
    "test:motorcycle": "node --experimental-strip-types --experimental-specifier-resolution=node scripts/check-motorcycle-support.mjs",
    "test:motorcycle-roadside": "node scripts/check-motorcycle-roadside.mjs",
    "test:pages": "node scripts/check-pages-build.mjs",
    "test:pwa": "node scripts/check-pwa.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "NODE_ENV=production node server.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
